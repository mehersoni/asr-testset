# Copy to .env (in the test-set root, next to scripts/) and fill in. Never commit .env.
ASR_BACKEND=server            # server | local

# --- ASR_BACKEND=server: VoicEra / OpenAI-style /v1/audio/transcriptions ---
ASR_BASE_URL=http://localhost:8000
ASR_API_KEY=
ASR_MODEL=indic-nemotron
ASR_LANG=mr                   # language code the server expects
ASR_WORKERS=1                 # keep 1 unless your server is deterministic under concurrency

# --- ASR_BACKEND=local: NeMo checkpoint on this machine ---
# VOICERA_ENGINE_DIR=/path/to/VoicEra/model-server/stt/indic-nemotron
# LOCAL_ASR_MODEL=bhili       # bhili | indic
# BHILI_NEMO_PATH=/path/to/indic_nemotron_bhili_sft.nemo
# ASR_LANG=bhb

# --- test-set settings (scripts/config.py) ---
TESTSET_LANG_CODE=mar
TESTSET_LANGUAGE=Marathi
FIELD_TEST_YEAR=2026
